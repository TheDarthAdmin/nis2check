<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Nis2Check evidence report</title>
<style>body{font:15px system-ui,sans-serif;color:#14213d;margin:3rem;max-width:1100px}header{border-bottom:3px solid #0b7285;padding-bottom:1rem}.meta{color:#52616b}article{border:1px solid #d8dee4;border-radius:8px;padding:1rem;margin:1rem 0}.PASS{border-left:6px solid #2b8a3e}.PARTIAL{border-left:6px solid #f08c00}.FAIL{border-left:6px solid #c92a2a}.INCONCLUSIVE{border-left:6px solid #6c757d}code,pre{white-space:pre-wrap;word-break:break-word}summary{cursor:pointer}</style>
</head><body><header><h1>Nis2Check evidence report</h1><p class="meta">Tenant: {{ run.tenant_id }} · UTC: {{ run.started_at }} · Tool: {{ run.tool_version }}</p><p>Technical evidence only; this is not a NIS2 conformance statement.</p></header>
{% for finding in findings %}<article class="{{ finding.verdict }}"><h2>{{ finding.control_id }} — {{ finding.title }}</h2><p><b>NIS2:</b> {{ finding.nis2 }} · <b>Verdict:</b> {{ finding.verdict }}</p><p>{{ finding.rationale }}</p><p><b>Endpoints:</b> {% for endpoint in finding.endpoints %}<code>{{ endpoint }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p><p><a href="{{ finding.remediation }}">Remediation guidance</a></p><p><b>Limit:</b> {{ finding.limits }}</p><details><summary>Raw evidence</summary><pre>{{ finding.raw_evidence | tojson(indent=2) }}</pre></details></article>{% endfor %}</body></html>
