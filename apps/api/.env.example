# PostgreSQL connection string. A Neon database created through Vercel is suitable.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The same tenant application that signs users in. These credentials are used only server-side
# to obtain a read-only, application-only Microsoft Graph token.
NIS2CHECK_TENANT_ID=00000000-0000-0000-0000-000000000000
NIS2CHECK_CLIENT_ID=00000000-0000-0000-0000-000000000000
NIS2CHECK_CLIENT_SECRET=replace-with-the-client-secret-value

# Generate both independently with: openssl rand -base64 48
# API key must exactly match NIS2CHECK_API_KEY in the Vercel web project.
NIS2CHECK_API_KEY=replace-with-a-long-random-api-key
EVIDENCE_HASH_KEY=replace-with-a-different-long-random-key

# The same CRON_SECRET used in the Vercel web project. It protects Vercel's daily request.
CRON_SECRET=replace-with-the-web-project-cron-secret
