<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nis2Check evidence report — {{ run.tenant_id }}</title>
<style>
/* Contemporan: ultramarine brand band, white bordered sections, monospace UI, serif display,
   hairline borders, 1px corners, no shadows. Self-contained: no external resources. */
:root{--brand:#0000f2;--brand-strong:#0000c2;--brand-soft:#dde1ff;--brand-softer:#f1f3ff;--lime:#edff45;--ink:#0a0a23;--body:#33374a;--muted:#6a6e85;--line:#dde1f5;--line-strong:#c4c8e0;--surface:#fff;--canvas:#fff;--tint:#f6f7fd;--fail:#c81e1e;--fail-soft:#fff1f2;--fail-line:#fecdd3;--partial:#b45309;--partial-soft:#fffaeb;--partial-line:#fed7aa;--pass:#15803d;--pass-soft:#ecfdf3;--pass-line:#bbf7d0;--font:ui-monospace,"Geist Mono","JetBrains Mono","Cascadia Mono","Segoe UI Mono",Consolas,monospace;--display:"Playfair Display",Georgia,"Times New Roman",serif}
@media(prefers-color-scheme:dark){:root{--brand:#5b5bff;--brand-strong:#7d7dff;--brand-soft:#c9caff;--brand-softer:#161634;--ink:#eceefb;--body:#c3c6dd;--muted:#9c9fb8;--line:#242745;--line-strong:#343858;--surface:#0d0e22;--canvas:#07071c;--tint:#111230;--fail:#ff8b8b;--fail-soft:#2a1416;--fail-line:#5e2326;--partial:#f0a95c;--partial-soft:#2a1f10;--partial-line:#5e4020;--pass:#6bd08a;--pass-soft:#0f2419;--pass-line:#1f4a31}}
*{box-sizing:border-box}
body{margin:0;color:var(--body);background:var(--canvas);font:14px/1.5 var(--font)}
.page{max-width:1100px;margin:0 auto;padding:0 24px 72px}
a{color:var(--brand)}
h1,h2,h3{color:var(--ink)}
h1{margin:0 0 10px;color:#fff;font-family:var(--display);font-size:2.5rem;line-height:1.05;letter-spacing:-1px}
h2{margin:0;color:var(--muted);font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}
h3{margin:0;font-size:.95rem;font-weight:700;letter-spacing:-.2px}
.meta{margin:0;color:var(--muted);font-size:.78rem}
.meta b{color:var(--ink);font-weight:600}
header.top{margin-bottom:28px;background:var(--brand);color:#fff}
header.top .page{padding-top:56px;padding-bottom:44px}
header.top .meta{color:var(--brand-soft)}
header.top .meta b{color:#fff}
.notice{display:inline-block;margin:20px 0 0;border-radius:1px;background:var(--lime);padding:8px 10px;color:#07071c;font-size:.8rem}
.card{margin:0 0 22px;border:1px solid var(--line);border-radius:1px;background:var(--surface);padding:20px}
.tally{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:12px 0 0;padding:0;list-style:none}
.chip{display:flex;flex-direction:column;align-items:flex-start;gap:3px;width:100%;border:1px solid var(--line);border-radius:1px;background:var(--surface);color:inherit;font:inherit;padding:14px;text-align:left;cursor:pointer}
.chip:hover{background:var(--tint)}
.chip[aria-pressed=true]{border-color:var(--brand);background:var(--brand-softer);box-shadow:inset 2px 0 0 var(--brand)}
.chip .count{font-size:1.5rem;font-weight:700;letter-spacing:-1px;line-height:1.1}
.chip .label{color:var(--ink);font-size:.75rem;font-weight:500}
.chip.FAIL .count{color:var(--fail)}.chip.PARTIAL .count{color:var(--partial)}.chip.PASS .count{color:var(--pass)}.chip.INCONCLUSIVE .count,.chip.NOT_APPLICABLE .count{color:var(--muted)}
.followup{display:grid;gap:0;margin:14px 0 0;padding:0;list-style:none;border:1px solid var(--line)}
.followup li+li a{border-top:1px solid var(--line)}
.followup a{display:flex;gap:12px;align-items:center;background:var(--surface);padding:11px 14px;color:inherit;text-decoration:none;font-size:.82rem}
.followup a:hover{background:var(--brand-softer)}
.followup .cid{color:var(--ink);font-weight:700}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;position:sticky;top:0;z-index:2;margin:0 0 18px;padding:12px 0;background:var(--canvas)}
.toolbar input,.toolbar select{min-width:12rem;border:1px solid var(--line-strong);border-radius:1px;background:var(--surface);padding:8px 10px;color:var(--ink);font:inherit;font-size:.82rem}
.toolbar input:focus-visible,.toolbar select:focus-visible,.chip:focus-visible,.link-button:focus-visible,.followup a:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.link-button{border:1px solid var(--line-strong);border-radius:1px;background:var(--surface);color:var(--ink);font:inherit;font-size:.78rem;padding:8px 10px;cursor:pointer}
.link-button:hover{border-color:var(--brand);background:var(--brand-softer);color:var(--brand)}
.result-count{margin-left:auto;color:var(--muted);font-size:.78rem}
.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.domain{margin:0 0 26px}
.domain-head{display:flex;align-items:baseline;gap:10px;margin:0 0 8px}
.domain-head .count{color:var(--muted);font-size:.78rem}
article{margin:0 0 10px;border:1px solid var(--line);border-left:3px solid var(--line-strong);border-radius:1px;background:var(--surface);padding:18px}
article:target{border-color:var(--brand)}
article.FAIL{border-left-color:var(--fail)}article.PARTIAL{border-left-color:var(--partial)}article.PASS{border-left-color:var(--pass)}article.INCONCLUSIVE,article.NOT_APPLICABLE{border-left-color:var(--line-strong)}
.finding-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px}
.finding-head .cid{margin-right:8px;color:var(--muted)}
.badge{border:1px solid transparent;border-radius:1px;padding:2px 7px;font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}
.badge.FAIL{border-color:var(--fail-line);background:var(--fail-soft);color:var(--fail)}.badge.PARTIAL{border-color:var(--partial-line);background:var(--partial-soft);color:var(--partial)}.badge.PASS{border-color:var(--pass-line);background:var(--pass-soft);color:var(--pass)}.badge.INCONCLUSIVE,.badge.NOT_APPLICABLE{border-color:var(--line-strong);background:var(--tint);color:var(--muted)}
.rationale{margin:12px 0 .2rem;color:var(--body)}
.hint{margin:0;color:var(--muted);font-size:.78rem}
.fields{display:grid;gap:12px;margin:16px 0 0;font-size:.82rem}
.fields dt{color:var(--muted);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
.fields dd{margin:5px 0 0}
code{border:1px solid var(--line);border-radius:1px;background:var(--tint);padding:2px 6px;font-size:.76rem}
code,pre{white-space:pre-wrap;word-break:break-word}
pre{max-height:26rem;overflow:auto;border:1px solid var(--line);border-radius:1px;background:var(--tint);padding:12px;font-size:.74rem}
.remediation{margin:16px 0 0;border:1px solid var(--line);border-left:3px solid var(--brand);border-radius:1px;background:var(--tint);padding:14px}
.remediation.settled{opacity:.7}
.remediation h4{margin:0 0 6px;color:var(--muted);font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
.remediation ol{display:grid;gap:7px;margin:0;padding-left:1.2rem;font-size:.82rem}
.remediation ol li::marker{color:var(--brand);font-weight:700}
.remediation p{margin:12px 0 0}
details{margin:16px 0 0;border-top:1px solid var(--line);padding-top:12px}
summary{cursor:pointer;color:var(--muted);font-size:.78rem}
.empty{display:none;padding:2rem 0;color:var(--muted);text-align:center}
.hidden{display:none!important}
footer{margin-top:36px;background:var(--brand);color:var(--brand-soft);font-size:.76rem}
footer .page{padding-top:24px;padding-bottom:24px}
@media print{body{background:#fff;color:#000}header.top,footer{background:#fff;color:#000}header.top{border-bottom:2px solid #000}header.top h1,header.top .meta,header.top .meta b{color:#000}.notice{border:1px solid #000;background:#fff;color:#000}.toolbar,.link-button{display:none}article,.card{break-inside:avoid}pre{max-height:none}}
</style>
</head><body>
<header class="top"><div class="page">
  <h1>Nis2Check evidence report</h1>
  <p class="meta">Tenant <b>{{ run.tenant_id }}</b> · Collected <b>{{ run.started_at.strftime('%Y-%m-%d %H:%M') }} UTC</b> · Collector <b>{{ run.tool_version }}</b> · <b>{{ findings | length }}</b> control{{ '' if findings | length == 1 else 's' }} evaluated</p>
  <p class="notice">Technical evidence only. This is not a NIS2 conformance statement.</p>
</div></header>
<div class="page">
<p class="meta" style="margin:0 0 22px">Only read-only Microsoft Graph queries were used, no aggregate score is calculated, and data that could not be read is reported as <b>inconclusive</b> rather than assumed.</p>

<section class="card" aria-labelledby="summary-heading">
  <h2 id="summary-heading">Verdicts</h2>
  <p class="meta">Select a verdict to filter the report.</p>
  <ul class="tally">
    {%- for verdict, count in tally %}
    <li><button type="button" class="chip {{ verdict }}" data-filter="{{ verdict }}" aria-pressed="false" title="{{ hints[verdict] }}"><span class="count">{{ count }}</span><span class="label">{{ verdict.replace('_', ' ') | capitalize }}</span></button></li>
    {%- endfor %}
  </ul>
  {%- if follow_up %}
  <h2 class="followup-heading" style="margin-top:1.4rem">Needs follow-up</h2>
  <p class="meta">{{ follow_up | length }} control{{ '' if follow_up | length == 1 else 's' }} could not be evidenced as fully in place.</p>
  <ul class="followup">
    {%- for finding in follow_up %}
    <li><a href="#{{ finding.control_id }}"><span class="cid">{{ finding.control_id }}</span><span>{{ finding.title }}</span><span class="badge {{ finding.verdict }}" style="margin-left:auto">{{ finding.verdict.replace('_', ' ') }}</span></a></li>
    {%- endfor %}
  </ul>
  {%- else %}
  <p class="meta" style="margin-top:1rem">Every evaluated control returned evidence that supports it, or was not applicable to this tenant.</p>
  {%- endif %}
</section>

<div class="toolbar" hidden id="toolbar">
  <label class="visually-hidden" for="search">Search findings</label>
  <input id="search" type="search" placeholder="Search control, rationale or endpoint" autocomplete="off">
  <label class="visually-hidden" for="domain">Domain</label>
  <select id="domain"><option value="">All domains</option>{% for domain, items in domains %}<option value="{{ domain }}">{{ domain | domain_label }} ({{ items | length }})</option>{% endfor %}</select>
  <button type="button" class="link-button" id="toggle-evidence" aria-pressed="false">Expand raw evidence</button>
  <button type="button" class="link-button hidden" id="reset" data-reset>Clear filters</button>
  <span class="result-count" id="result-count" role="status" aria-live="polite"></span>
</div>

{%- for domain, items in domains %}
<section class="domain" data-domain-section="{{ domain }}">
  <div class="domain-head"><h2 id="domain-{{ domain }}">{{ domain | domain_label }}</h2><span class="count" data-domain-count>{{ items | length }} control{{ '' if items | length == 1 else 's' }}</span></div>
  {%- for finding in items %}
  <article class="{{ finding.verdict }}" id="{{ finding.control_id }}" data-verdict="{{ finding.verdict }}" data-domain="{{ finding.domain }}" data-search="{{ (finding.control_id ~ ' ' ~ finding.title ~ ' ' ~ finding.rationale ~ ' ' ~ finding.domain ~ ' ' ~ finding.nis2 ~ ' ' ~ finding.endpoints | join(' ')) | lower }}">
    <div class="finding-head"><h3><span class="cid">{{ finding.control_id }}</span>{{ finding.title }}</h3><span class="badge {{ finding.verdict }}">{{ finding.verdict.replace('_', ' ') }}</span></div>
    <p class="meta">{{ finding.domain | domain_label }} · NIS2 article {{ finding.nis2 }}</p>
    <p class="rationale">{{ finding.rationale }}</p>
    <p class="hint">{{ hints[finding.verdict] }}</p>
    <dl class="fields">
      <div><dt>Queried endpoints</dt><dd>{% for endpoint in finding.endpoints %}<code>{{ endpoint }}</code>{% if not loop.last %} {% endif %}{% endfor %}</dd></div>
      <div><dt>Limitation of this check</dt><dd>{{ finding.limits }}</dd></div>
    </dl>
    {%- if finding.remediation_steps %}
    <div class="remediation {{ 'settled' if finding.verdict in ('PASS', 'NOT_APPLICABLE') else 'needed' }}">
      <h4>How to remediate</h4>
      <ol>{% for step in finding.remediation_steps %}<li>{{ step }}</li>{% endfor %}</ol>
      <p class="meta"><a href="{{ finding.remediation }}" rel="noreferrer">Microsoft guidance for {{ finding.control_id }} ↗</a></p>
    </div>
    {%- endif %}
    <details><summary>Raw evidence as returned by Microsoft Graph</summary><pre>{{ finding.raw_evidence | tojson(indent=2) }}</pre></details>
  </article>
  {%- endfor %}
</section>
{%- endfor %}

<p class="empty" id="empty">No control matches the current filters. <button type="button" class="link-button" data-reset>Clear filters</button></p>

</div>
<footer><div class="page">Generated by Nis2Check {{ run.tool_version }}. The evidence reflects the tenant configuration at {{ run.started_at.strftime('%Y-%m-%d %H:%M') }} UTC and says nothing about the period before or after it.</div></footer>
<script>
(function () {
  var toolbar = document.getElementById("toolbar");
  var search = document.getElementById("search");
  var domain = document.getElementById("domain");
  var reset = document.getElementById("reset");
  var count = document.getElementById("result-count");
  var empty = document.getElementById("empty");
  var evidence = document.getElementById("toggle-evidence");
  var chips = Array.prototype.slice.call(document.querySelectorAll(".chip"));
  var articles = Array.prototype.slice.call(document.querySelectorAll("article[data-verdict]"));
  var sections = Array.prototype.slice.call(document.querySelectorAll("[data-domain-section]"));
  var verdicts = [];
  toolbar.hidden = false;

  function apply() {
    var query = search.value.trim().toLowerCase();
    var visible = 0;
    articles.forEach(function (article) {
      var match =
        (verdicts.length === 0 || verdicts.indexOf(article.getAttribute("data-verdict")) !== -1) &&
        (domain.value === "" || domain.value === article.getAttribute("data-domain")) &&
        (query === "" || article.getAttribute("data-search").indexOf(query) !== -1);
      article.classList.toggle("hidden", !match);
      if (match) visible += 1;
    });
    sections.forEach(function (section) {
      var shown = section.querySelectorAll("article:not(.hidden)").length;
      var total = section.querySelectorAll("article").length;
      var label = section.querySelector("[data-domain-count]");
      section.classList.toggle("hidden", shown === 0);
      label.textContent = (shown === total ? total : shown + " of " + total) + (total === 1 ? " control" : " controls");
    });
    var filtered = verdicts.length > 0 || domain.value !== "" || query !== "";
    count.textContent = filtered ? visible + " of " + articles.length + " controls shown" : "";
    reset.classList.toggle("hidden", !filtered);
    empty.style.display = visible === 0 ? "block" : "none";
  }

  function clearFilters() {
    verdicts = [];
    chips.forEach(function (chip) { chip.setAttribute("aria-pressed", "false"); });
    search.value = "";
    domain.value = "";
    apply();
  }

  chips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      var verdict = chip.getAttribute("data-filter");
      var index = verdicts.indexOf(verdict);
      if (index === -1) { verdicts.push(verdict); } else { verdicts.splice(index, 1); }
      chip.setAttribute("aria-pressed", index === -1 ? "true" : "false");
      apply();
    });
  });
  search.addEventListener("input", apply);
  domain.addEventListener("change", apply);
  evidence.addEventListener("click", function () {
    var open = evidence.getAttribute("aria-pressed") !== "true";
    Array.prototype.forEach.call(document.querySelectorAll("details"), function (item) { item.open = open; });
    evidence.setAttribute("aria-pressed", open ? "true" : "false");
    evidence.textContent = open ? "Collapse raw evidence" : "Expand raw evidence";
  });
  Array.prototype.forEach.call(document.querySelectorAll("[data-reset]"), function (button) {
    button.addEventListener("click", clearFilters);
  });
  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && document.activeElement === search) { clearFilters(); }
    if (event.key === "/" && document.activeElement !== search) { event.preventDefault(); search.focus(); }
  });
  window.addEventListener("beforeprint", function () {
    Array.prototype.forEach.call(document.querySelectorAll(".hidden"), function (item) {
      if (item.tagName === "ARTICLE" || item.classList.contains("domain")) { item.classList.remove("hidden"); }
    });
  });
  apply();
})();
</script>
</body></html>
