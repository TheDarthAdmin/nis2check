<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>Nis2Check evidence dossier — {{ run.tenant_id }}</title>
<style>
/* Contemporan, laid out for paper: ultramarine cover, hairline borders, 1px corners, no
   shadows, monospace body, serif display. Self-contained: no external resources. */
:root{
  --brand:#0000f2;--brand-soft:#dde1ff;--brand-softer:#f1f3ff;--lime:#edff45;
  --ink:#0a0a23;--body:#33374a;--muted:#6a6e85;--line:#dde1f5;--line-strong:#c4c8e0;
  --surface:#fff;--tint:#f6f7fd;
  --fail:#c81e1e;--fail-soft:#fff1f2;--fail-line:#fecdd3;
  --partial:#b45309;--partial-soft:#fffaeb;--partial-line:#fed7aa;
  --pass:#15803d;--pass-soft:#ecfdf3;--pass-line:#bbf7d0;
  --font:ui-monospace,"Geist Mono","DejaVu Sans Mono","Cascadia Mono",Consolas,monospace;
  --display:"Playfair Display",Georgia,"Times New Roman",serif;
}
@page{
  size:A4; margin:18mm 16mm 18mm;
  @bottom-left{content:"Nis2Check — technical evidence, not a conformance statement";font:7.5pt var(--font);color:#6a6e85}
  @bottom-right{content:counter(page) " / " counter(pages);font:7.5pt var(--font);color:#6a6e85}
}
@page cover{margin:0;@bottom-left{content:none}@bottom-right{content:none}}
*{box-sizing:border-box}
body{margin:0;color:var(--body);background:#fff;font:9.5pt/1.5 var(--font)}
h1,h2,h3,h4{color:var(--ink);margin:0}
a{color:var(--brand);text-decoration:none;word-break:break-all}
.cover{page:cover;height:297mm;display:flex;flex-direction:column;justify-content:space-between;background:var(--brand);color:#fff;padding:24mm 18mm}
.cover h1{color:#fff;font-family:var(--display);font-size:34pt;line-height:1.02;letter-spacing:-1px;margin:0 0 6mm}
.cover .lede{color:var(--brand-soft);font-size:10pt;max-width:120mm}
.cover dl{display:grid;grid-template-columns:38mm 1fr;gap:2mm 6mm;margin:0;font-size:9pt}
.cover dt{color:var(--brand-soft);text-transform:uppercase;letter-spacing:.08em;font-size:7.5pt}
.cover dd{margin:0;color:#fff}
.cover .notice{display:inline-block;background:var(--lime);color:#07071c;padding:3mm 4mm;font-size:8.5pt;max-width:130mm}
.cover .verdictline{border-top:1px solid rgba(255,255,255,.35);padding-top:5mm;color:var(--brand-soft);font-size:8.5pt}
section{break-before:page}
section.flow{break-before:auto}
.sec-head{border-bottom:2px solid var(--brand);padding-bottom:2mm;margin:0 0 5mm}
.sec-head .eyebrow{display:block;color:var(--muted);font-size:7.5pt;letter-spacing:.12em;text-transform:uppercase;margin-bottom:1.5mm}
.sec-head h2{font-family:var(--display);font-size:18pt;letter-spacing:-.4px}
p{margin:0 0 3mm}
.lead{font-size:10pt;color:var(--ink)}
.muted{color:var(--muted);font-size:8.5pt}
.card{border:1px solid var(--line);background:var(--surface);padding:5mm;margin:0 0 4mm;break-inside:avoid}
.card.accent{border-left:3px solid var(--brand);background:var(--brand-softer)}
dl.facts{display:grid;grid-template-columns:42mm 1fr;gap:2mm 5mm;margin:0;font-size:9pt}
dl.facts dt{color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-size:7.5pt}
dl.facts dd{margin:0;color:var(--ink)}
.badge{display:inline-block;margin:0 1mm .8mm 0;border:1px solid var(--line-strong);background:var(--tint);color:var(--muted);padding:.6mm 2mm;font-size:7.5pt;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.badge.FAIL{border-color:var(--fail-line);background:var(--fail-soft);color:var(--fail)}
.badge.PARTIAL{border-color:var(--partial-line);background:var(--partial-soft);color:var(--partial)}
.badge.PASS{border-color:var(--pass-line);background:var(--pass-soft);color:var(--pass)}
/* A classification is not a grade, so it does not borrow the verdict palette. */
.badge.ESSENTIAL,.badge.IMPORTANT{border-color:var(--brand);background:var(--brand-softer);color:var(--brand)}
.badge.OUT_OF_SCOPE,.badge.UNDETERMINED{border-color:var(--line-strong);background:var(--tint);color:var(--muted)}
.badge.big{font-size:11pt;padding:1.5mm 4mm}
table{width:100%;border-collapse:collapse;font-size:8.5pt;table-layout:fixed}
table.auto{table-layout:auto}
th,td{border:1px solid var(--line);padding:2mm 2.5mm;text-align:left;vertical-align:top}
th{background:var(--tint);color:var(--muted);font-size:7.5pt;letter-spacing:.08em;text-transform:uppercase;font-weight:600}
td.num{text-align:right;white-space:nowrap}
tr{break-inside:avoid}
.tally{display:flex;flex-wrap:wrap;gap:3mm;margin:0 0 5mm;padding:0;list-style:none}
.tally li{border:1px solid var(--line);padding:3mm 4mm;min-width:30mm}
.tally .count{display:block;font-size:16pt;font-weight:700;line-height:1.1;letter-spacing:-.5px;color:var(--ink)}
.tally .label{color:var(--muted);font-size:7.5pt;text-transform:uppercase;letter-spacing:.08em}
.tally li.FAIL .count{color:var(--fail)}.tally li.PARTIAL .count{color:var(--partial)}.tally li.PASS .count{color:var(--pass)}
article.finding{border:1px solid var(--line);border-left:3px solid var(--line-strong);padding:4mm 5mm;margin:0 0 3.5mm;break-inside:avoid}
article.finding.FAIL{border-left-color:var(--fail)}
article.finding.PARTIAL{border-left-color:var(--partial)}
article.finding.PASS{border-left-color:var(--pass)}
.finding-head{display:flex;justify-content:space-between;align-items:baseline;gap:4mm;margin:0 0 2mm}
.finding-head h4{font-size:9.5pt;letter-spacing:-.2px}
.finding-head .cid{color:var(--muted);font-weight:400}
.rationale{margin:0 0 2.5mm;color:var(--ink)}
.field{margin:2.5mm 0 0;font-size:8.5pt}
.field .k{display:block;color:var(--muted);font-size:7pt;letter-spacing:.08em;text-transform:uppercase;margin-bottom:1mm}
ol.steps{margin:0;padding-left:5mm;font-size:8.5pt}
ol.steps li{margin:0 0 1mm}
ul.plain{margin:0;padding-left:4.5mm}
code{background:var(--tint);border:1px solid var(--line);padding:.3mm 1.2mm;font-size:8pt;word-break:break-all}
.domain-head{display:flex;align-items:baseline;gap:3mm;margin:6mm 0 3mm;break-after:avoid}
.domain-head h3{font-size:11pt}
.domain-head .count{color:var(--muted);font-size:8pt}
.empty{color:var(--muted);font-style:italic}
</style></head>
<body>

<div class="cover">
  <div>
    <p class="lede" style="margin-bottom:8mm">Nis2Check</p>
    <h1>Evidence dossier</h1>
    <p class="lede">Technically verifiable evidence for NIS2 article 21(2), read from Microsoft&nbsp;365 with read-only Microsoft Graph queries.</p>
  </div>
  <div>
    {% if scoping %}<p><span class="badge big {{ scoping.classification }}">{{ scoping.classification.replace('_', ' ') }}</span></p>{% endif %}
    <dl>
      {% if profile and profile.name %}<dt>Organisation</dt><dd>{{ profile.name }}</dd>{% endif %}
      {% if profile and profile.registration_number %}<dt>Registration</dt><dd>{{ profile.registration_number }}</dd>{% endif %}
      <dt>Tenant</dt><dd>{{ run.tenant_id }}</dd>
      <dt>Collected</dt><dd>{{ run.started_at.strftime('%Y-%m-%d %H:%M UTC') }}</dd>
      <dt>Generated</dt><dd>{{ generated_at.strftime('%Y-%m-%d %H:%M UTC') }}</dd>
      <dt>Tool version</dt><dd>{{ run.tool_version }}</dd>
      <dt>Controls run</dt><dd>{{ findings | length }}</dd>
    </dl>
  </div>
  <div>
    <p class="notice">This dossier reports evidence, not compliance. NIS2 is largely organisational; what can be read from a tenant is only part of article 21(2), and no part of this document is a conformance statement.</p>
    <p class="verdictline">{% for verdict, count in tally %}{{ count }} {{ verdict.replace('_', ' ') | lower }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
  </div>
</div>

{% if scoping %}
<section>
  <div class="sec-head"><span class="eyebrow">Section 1</span><h2>Scope and classification</h2></div>
  <p class="lead">Whether the directive applies, and as what. This rests on figures the organisation declared about itself. Nothing in this section was read from the tenant.</p>
  <div class="card accent">
    <p style="margin-bottom:3mm"><span class="badge big {{ scoping.classification }}">{{ scoping.classification.replace('_', ' ') }}</span></p>
    <p class="lead" style="margin-bottom:3mm">{{ classification_hint[scoping.classification] }}</p>
    <p style="margin:0">{{ scoping.rationale }}</p>
  </div>
  <dl class="facts">
    {% if scoping.sector %}
    <dt>Sector</dt><dd>{{ scoping.sector.sector }} — {{ scoping.sector.subsector }}</dd>
    <dt>Annex</dt><dd>Annex {{ scoping.sector.annex_point }}</dd>
    {% else %}
    <dt>Sector</dt><dd>Not listed in annex I or annex II</dd>
    {% endif %}
    <dt>Enterprise size</dt><dd>{{ scoping.size.replace('_', ' ') | lower }}</dd>
    <dt>In scope</dt><dd>{% if scoping.in_scope is none %}Could not be settled{% elif scoping.in_scope %}Yes{% else %}No{% endif %}</dd>
    <dt>Legal basis</dt><dd>{{ scoping.legal_basis | join(' · ') }}</dd>
  </dl>
  {% if scoping.supervision %}
  <h3 style="font-size:10pt;margin:6mm 0 2.5mm">What this means</h3>
  <ul class="plain">{% for line in scoping.supervision %}<li style="margin-bottom:1.5mm">{{ line }}</li>{% endfor %}</ul>
  {% endif %}
  <p class="muted" style="margin-top:5mm">Directive (EU) 2022/2555, article 2 for scope and article 3 for the tier; enterprise size follows the annex to recommendation 2003/361/EC. A Member State may designate an entity regardless of these rules.</p>
</section>
{% endif %}

<section>
  <div class="sec-head"><span class="eyebrow">Section {% if scoping %}2{% else %}1{% endif %}</span><h2>How to read this dossier</h2></div>
  <p class="lead">Every finding carries the evidence it rests on and the limit of what that evidence proves.</p>
  <ul class="tally">
    {% for verdict, count in tally %}<li class="{{ verdict }}"><span class="count">{{ count }}</span><span class="label">{{ verdict.replace('_', ' ') | lower }}</span></li>{% endfor %}
  </ul>
  <table>
    <thead><tr><th style="width:32mm">Verdict</th><th>What it means here</th></tr></thead>
    <tbody>{% for verdict, hint in hints.items() %}<tr><td><span class="badge {{ verdict }}">{{ verdict.replace('_', ' ') }}</span></td><td>{{ hint }}</td></tr>{% endfor %}</tbody>
  </table>
  <div class="card" style="margin-top:5mm">
    <h3 style="font-size:10pt;margin-bottom:2.5mm">Deliberately absent</h3>
    <p style="margin-bottom:2mm">There is no total and no percentage. A single number invites working towards the number rather than towards the measure, and it would hide which of the ten measures is unevidenced.</p>
    <p style="margin:0">Nothing was guessed. Where evidence could not be read, the verdict is <span class="badge INCONCLUSIVE">inconclusive</span> and the reason is stated with it.</p>
  </div>
</section>

<section>
  <div class="sec-head"><span class="eyebrow">Section {% if scoping %}3{% else %}2{% endif %}</span><h2>Coverage of article 21(2)</h2></div>
  <p class="lead">The ten risk-management measures, and what this run could say about each. A measure with no finding is not a measure that is met.</p>
  <table>
    <thead><tr><th style="width:9mm"></th><th>Measure</th><th class="num" style="width:18mm">Controls</th><th style="width:40mm">Verdicts</th></tr></thead>
    <tbody>
      {% for letter, title, measure_findings, measure_tally in measures %}
      <tr>
        <td><b>({{ letter }})</b></td>
        <td>{{ title }}{% if measure_findings %}<br><span class="muted">{{ measure_findings | map(attribute='control_id') | join(', ') }}</span>{% endif %}</td>
        <td class="num">{{ measure_findings | length }}</td>
        <td>{% if measure_findings %}{% for verdict, count in measure_tally %}{% if count %}<span class="badge {{ verdict }}">{{ count }} {{ verdict.replace('_', ' ') | lower }}</span> {% endif %}{% endfor %}{% else %}<span class="empty">no control</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <div class="sec-head"><span class="eyebrow">Section {% if scoping %}4{% else %}3{% endif %}</span><h2>Findings that need follow-up</h2></div>
  {% if follow_up %}
  <p class="lead">{{ follow_up | length }} of {{ findings | length }} controls failed, were only partly evidenced, or could not be read. Each one is set out in full in the next section.</p>
  <table>
    <thead><tr><th style="width:16mm">Control</th><th style="width:30mm">Verdict</th><th>Finding</th></tr></thead>
    <tbody>
      {% for finding in follow_up %}
      <tr><td><b>{{ finding.control_id }}</b></td><td><span class="badge {{ finding.verdict }}">{{ finding.verdict.replace('_', ' ') }}</span></td><td>{{ finding.title }}<br><span class="muted">{{ finding.nis2 }} · {{ finding.domain | domain_label }}</span></td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="lead">No control needs follow-up: every check is evidenced or does not apply to this tenant. The limits in appendix A still bound what that means.</p>
  {% endif %}
</section>

<section>
  <div class="sec-head"><span class="eyebrow">Section {% if scoping %}5{% else %}4{% endif %}</span><h2>Findings in full</h2></div>
  <p class="lead">Grouped by domain, follow-up first within each. The rationale is our reading; the raw Graph response it rests on is in the JSON result that accompanies this dossier.</p>
  {% for domain, domain_findings in domains %}
  <div class="domain-head"><h3>{{ domain | domain_label }}</h3><span class="count">{{ domain_findings | length }} control{{ '' if domain_findings | length == 1 else 's' }}</span></div>
  {% for finding in domain_findings %}
  <article class="finding {{ finding.verdict }}">
    <div class="finding-head">
      <h4><span class="cid">{{ finding.control_id }}</span> {{ finding.title }}</h4>
      <span class="badge {{ finding.verdict }}">{{ finding.verdict.replace('_', ' ') }}</span>
    </div>
    <p class="muted" style="margin:0 0 2mm">NIS2 {{ finding.nis2 }}</p>
    <p class="rationale">{{ finding.rationale }}</p>
    {% if finding.verdict in follow_up_verdicts and finding.remediation_steps %}
    <div class="field"><span class="k">How to remediate</span>
      <ol class="steps">{% for step in finding.remediation_steps %}<li>{{ step }}</li>{% endfor %}</ol>
      <p class="muted" style="margin:1.5mm 0 0"><a href="{{ finding.remediation }}">{{ finding.remediation }}</a></p>
    </div>
    {% endif %}
    {% if finding.limits %}<div class="field"><span class="k">What this does not prove</span>{{ finding.limits }}</div>{% endif %}
    <div class="field"><span class="k">Read from</span>{% for endpoint in finding.endpoints %}<code>{{ endpoint }}</code>{% if not loop.last %} {% endif %}{% endfor %}</div>
  </article>
  {% endfor %}
  {% endfor %}
</section>

<section>
  <div class="sec-head"><span class="eyebrow">Appendix A</span><h2>What this dossier does not prove</h2></div>
  <p class="lead">Every control's stated limit, including the passing ones. A passing control whose limit is not read is the easiest way for a dossier to mislead.</p>
  <table>
    <thead><tr><th style="width:16mm">Control</th><th style="width:30mm">Verdict</th><th>Limit</th></tr></thead>
    <tbody>
      {% for finding in limits %}
      <tr><td><b>{{ finding.control_id }}</b></td><td><span class="badge {{ finding.verdict }}">{{ finding.verdict.replace('_', ' ') }}</span></td><td>{{ finding.limits }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <div class="sec-head"><span class="eyebrow">Appendix B</span><h2>Everything that was read</h2></div>
  <p class="lead">Every Microsoft Graph endpoint this run queried, and the controls that queried it. All of them are GET requests; the collector holds no write permission and contains no write path.</p>
  <table>
    <thead><tr><th>Endpoint</th><th style="width:34mm">Controls</th></tr></thead>
    <tbody>
      {% for endpoint, control_ids in endpoints %}
      <tr><td><code>{{ endpoint }}</code></td><td>{{ control_ids | join(', ') }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="muted" style="margin-top:5mm">Generated by Nis2Check {{ run.tool_version }} on {{ generated_at.strftime('%Y-%m-%d') }}. Technical evidence only; this document is not a NIS2 conformance statement.</p>
</section>

</body></html>
