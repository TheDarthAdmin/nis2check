# Public URL of this deployment. Do not include a trailing slash.
APP_URL=https://your-project.vercel.app

# Microsoft Entra application (Web platform, single-tenant application).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-a-client-secret-value

# Create with: openssl rand -base64 48
# This only signs Nis2Check's own secure session cookie.
AUTH_SECRET=replace-with-a-long-random-secret
